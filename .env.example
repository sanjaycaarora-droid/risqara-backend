XAI_API_KEY=
SEC_CONTACT_EMAIL=your-real-email@example.com
# Set to false to disable Grok's live X/web search (falls back to a plain completion)
RISQARA_ENABLE_LIVE_SEARCH=true

# Optional — each of these degrades gracefully to "no data" if left blank.

# Free FRED macro indicators (Fed funds rate, CPI, unemployment).
# Get a key at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Reddit blocks all unauthenticated requests. Register a free "script" app at
# https://www.reddit.com/prefs/apps to get these two values.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
